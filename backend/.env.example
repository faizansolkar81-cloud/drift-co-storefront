# =============================================================
# Drift & Co. — Environment Variables (Example)
# Copy this file to ".env" and fill in your MySQL credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit the real .env file to version control.
# =============================================================

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=drift_and_co

# ---- JWT Auth ----
# Change SECRET_KEY to a long random string for any deployment
SECRET_KEY=change_me_to_a_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
